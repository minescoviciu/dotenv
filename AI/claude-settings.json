{
  "permissions": {
    "allow": [
      "WebFetch(domain:neovim.io)",
      "Bash(mkdir:*)",
      "WebFetch(domain:developers.notion.com)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/AI/claude-assets/notification-hook.sh"
          },
          {
            "type": "command",
            "command": "$HOME/dotfiles/AI/claude-assets/last-response-hook.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/AI/claude-assets/notification-hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/AI/claude-assets/permission-evaluator.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/dotfiles/AI/claude-assets/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false,
  "showMessageTimestamps": true,
  "showTurnDuration": true,
  "mcpServers": {},
  "disableClaudeAiConnectors": true,
  "model": "claude-fable-5[1m]"
}
