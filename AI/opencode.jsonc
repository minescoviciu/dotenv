{
  "$schema": "https://opencode.ai/config.json",
  // Theme configuration
  "theme": "catppuccin",
  "plugin": [
    // "opencode-openai-codex-auth"
  ],
  "autoupdate": true,
  // Take models from https://models.dev/api.json
  // Using OpenAI 5.2 Codex with OAuth authentication
  "model": "openai/gpt-5.3-codex:high",
  "small_model": "openai/gpt-5.3-codex",
  "provider": {
      // "openai": {
      //     "options": {
      //         "apiKey": "{env:OPENAI_API_KEY}"
      //     }
      // }
  },
  // Custom keybindings
  "keybinds": {
      "session_list": "ctrl+l",
      "app_exit": "ctrl+c,<leader>q",
      "messages_half_page_down": "ctrl+d",
      "messages_half_page_up": "ctrl+u",
      "session_child_cycle": "<leader>+k",
      "session_child_cycle_reverse": "<leader>+j"
  }
}

